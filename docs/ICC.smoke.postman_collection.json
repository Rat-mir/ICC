{
  "info": {
    "name": "ICC MySQL — executable Postman verification",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://api.icc.local"
    }
  ],
  "item": [
    {
      "name": "01 Health MySQL",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/health",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              "pm.test(\"mysql\",()=>pm.expect(pm.response.json().driver).to.eql(\"mysql\"));"
            ]
          }
        }
      ]
    },
